+    angular_scale = (max_angular_acceleration * dt / delta_twist[..., 1].abs().clamp_min(1e-8))
+    scale = torch.minimum(linear_scale, angular_scale).clamp(max=1.0)
+    return previous_wheels + delta_wheels * scale.unsqueeze(-1), scale
 
 
